# ClaudeX uses NVIDIA API inference exclusively.
NVIDIA_API_KEY=nvapi-PASTE_YOUR_KEY_HERE
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_EFFORT=Medium
AUTO_THINK=true
AUTO_MEMORY=true
# Set a unique token of at least 32 characters before allowing remote clients.
# CLAUDEX_ACCESS_TOKEN=
COUNCIL_REVIEWER_LOGIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b
COUNCIL_REVIEWER_SYSTEMS_MODEL=nvidia/nemotron-3.5-bolt-e4b
