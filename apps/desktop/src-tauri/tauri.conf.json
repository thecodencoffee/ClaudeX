{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeX",
  "version": "0.1.0",
  "identifier": "com.claudex.desktop",
  "build": {
    "frontendDist": "../../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClaudeX",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/backend/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
